# Railway provides this from its PostgreSQL service.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Use a unique, long random value. Never put this value in the frontend.
JWT_SECRET="replace-with-a-long-random-secret"

# Comma-separated only if you intentionally host more than one frontend.
FRONTEND_URL="http://localhost:5173"

# Required once when the production database is first seeded.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"

# On Railway, attach a Volume at /app/uploads and set this exact value.
UPLOADS_DIR="/app/uploads"

# Optional social sign-in. Register these exact callback URLs with each provider.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
FACEBOOK_CALLBACK_URL="http://localhost:5000/api/auth/facebook/callback"
